# Sao chép thành file .env khi chạy trên máy, hoặc khai báo trong phần Environment của hosting.

NODE_ENV=production
PORT=3000
SITE_URL=https://tripdn.com

# Chuỗi bí mật ngẫu nhiên để mã hoá phiên đăng nhập (BẮT BUỘC khi production)
SESSION_SECRET=thay-bang-chuoi-ngau-nhien-dai

# Tài khoản quản trị tạo ở lần chạy đầu tiên (đổi mật khẩu trong Dashboard sau đó)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Thư mục lưu database và ảnh upload (trên Render/Railway trỏ vào ổ đĩa bền vững)
DATA_DIR=./data

# Kết nối Google Sheet & Gmail — xem docs/HUONG-DAN-GOOGLE-SHEET.md
GOOGLE_SCRIPT_URL=
GOOGLE_SCRIPT_SECRET=
