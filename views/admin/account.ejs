<%- include('_head') %>
<div class="topline"><h1>Tài khoản</h1></div>
<div class="grid grid--2e">
  <form class="card form" method="post" action="/admin/account/password">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <h2>Đổi mật khẩu (<%= adminUser %>)</h2>
    <div><label for="current">Mật khẩu hiện tại</label><input type="password" id="current" name="current" autocomplete="current-password" required></div>
    <div><label for="password">Mật khẩu mới</label><input type="password" id="password" name="password" autocomplete="new-password" minlength="8" required></div>
    <div><label for="confirm">Nhập lại mật khẩu mới</label><input type="password" id="confirm" name="confirm" autocomplete="new-password" minlength="8" required></div>
    <div class="actions"><button class="btn">Đổi mật khẩu</button></div>
  </form>

  <div class="card">
    <h2>Tài khoản quản trị</h2>
    <table><tbody><% users.forEach(function (u) { %>
      <tr><td><strong><%= u.username %></strong><br><span class="muted small">Tạo <%= h.fmtDate(u.created_at) %></span></td>
      <td style="text-align:right"><% if (u.username !== adminUser) { %><form method="post" action="/admin/account/users/<%= u.id %>/delete" data-confirm="Xoá tài khoản <%= u.username %>?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn--sm btn--danger">Xoá</button></form><% } else { %><span class="badge">Bạn</span><% } %></td></tr>
    <% }) %></tbody></table>
    <form class="form" method="post" action="/admin/account/users" style="margin-top:18px">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <h2>Thêm tài khoản nhân viên</h2>
      <div class="form-row">
        <div><label for="nu">Tên đăng nhập</label><input type="text" id="nu" name="username" required pattern="[a-z0-9._\-]{3,30}"></div>
        <div><label for="np">Mật khẩu</label><input type="password" id="np" name="password" minlength="8" required autocomplete="new-password"></div>
      </div>
      <div class="actions"><button class="btn btn--ghost">Tạo tài khoản</button></div>
    </form>
  </div>
</div>
<%- include('_foot') %>
