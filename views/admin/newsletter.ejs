<%- include('_head') %>
<div class="topline"><h1>Gửi bản tin tour hàng tháng</h1><span class="muted"><%= active %> người đang nhận tin</span></div>

<div class="grid grid--2">
  <% if (busy) { %><div class="flash flash--error">Đang có một đợt gửi bản tin. Vui lòng đợi vài phút rồi tải lại trang.</div><% } %>
  <form class="card form" method="post" action="/admin/newsletter" data-confirm-submit data-once>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div><label for="subject">Tiêu đề email</label><input type="text" id="subject" name="subject" required maxlength="200" placeholder="VD: TRIP – Lịch tour tháng <%= new Date().getMonth() + 2 > 12 ? 1 : new Date().getMonth() + 2 %> & ưu đãi visa"></div>
    <div>
      <label for="body">Lời nhắn</label>
      <textarea id="body" name="body" required placeholder="Chào bạn,&#10;&#10;Tháng này TRIP có các tour mới khởi hành từ Đà Nẵng…"></textarea>
      <p class="hint">Xuống dòng sẽ được giữ nguyên trong email. Có thể dùng **chữ đậm**.</p>
    </div>
    <div>
      <label>Đính kèm tour (hiển thị dạng thẻ trong email)</label>
      <div style="display:grid;gap:6px;max-height:260px;overflow:auto;border:1px solid var(--line);border-radius:10px;padding:10px">
        <% tours.forEach(function (t) { %><label class="check"><input type="checkbox" name="tours" value="<%= t.id %>"<%= t.featured ? ' checked' : '' %>> <%= t.title %> <span class="muted small">— <%= t.price ? h.vnd(t.price) : 'Liên hệ' %></span></label><% }) %>
      </div>
    </div>
    <div class="actions">
      <button class="btn btn--ghost" name="mode" value="test" title="<%= testEmails.join(', ') %>">Gửi thử tới email quản trị</button>
      <button class="btn btn--accent" name="mode" value="all">Gửi tới <%= active %> người nhận</button>
    </div>
    <p class="hint">Email được gửi từ Gmail đã cài Google Apps Script, mỗi lần tối đa 80 người. Gmail cá nhân giới hạn khoảng 100 email/ngày (cả email thông báo khách mới), nên danh sách lớn sẽ gửi trong nhiều ngày: bấm "Gửi tiếp" ở lịch sử bên phải. Mỗi email có link huỷ đăng ký.</p>
  </form>

  <div class="card">
    <h2>Lịch sử gửi</h2>
    <% if (history.length) { %>
      <table><thead><tr><th>Ngày</th><th>Tiêu đề</th><th>Đã gửi</th><th></th></tr></thead>
      <tbody><% history.forEach(function (n) { %><tr>
        <td class="small nowrap"><%= h.fmtDate(n.created_at, true) %></td><td><%= n.subject %></td>
        <td class="small nowrap"><%= n.sent %> người<% if (n.remaining) { %><br><span class="muted">còn <%= n.remaining %></span><% } %><% if (n.unknown) { %><br><span class="muted" title="Mất kết nối với Google giữa chừng: không tự gửi lại để tránh khách nhận 2 lần">chưa rõ <%= n.unknown %></span>
          <form method="post" action="/admin/newsletter/<%= n.id %>/release" data-confirm="Chỉ làm khi đã kiểm tra mục 'Đã gửi' trong Gmail: những người 'chưa rõ' sẽ được gửi lại, có thể vài người nhận 2 lần. Tiếp tục?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn--sm btn--ghost">Cho phép gửi lại</button></form><% } %></td>
        <td><% if (n.remaining) { %><form method="post" action="/admin/newsletter/<%= n.id %>/continue" data-once><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn--sm">Gửi tiếp</button></form><% } else { %><span class="badge badge--published">Xong</span><% } %></td>
      </tr><% }) %></tbody></table>
    <% } else { %><p class="muted">Chưa gửi bản tin nào.</p><% } %>
  </div>
</div>
<%- include('_foot') %>
