<%- include('../partials/head') %>
<%- include('../partials/page-hero', {
  crumbs: [{ label: 'Giới thiệu' }],
  heading: 'Về',
  headingEm: 'TRIP',
  sub: company.legalName + '. Chuyên dịch thuật và dịch vụ du lịch tại Đà Nẵng.',
  actions: null,
  visual: '/img/team/team.jpg',
  badge: { value: company.stats[0].value + company.stats[0].suffix, label: 'Đồng hành cùng khách' },
  stamp: { top: 'TRIP · ĐÀ NẴNG · VISA · DỊCH THUẬT · ', mid: 'TRIP', sub: 'TEAM', cls: 'stamp--hero stamp--kr' },
}) %>

<section class="section">
  <div class="container why">
    <figure class="photo-frame photo-frame--tall reveal">
      <%- h.picture('/img/team/heart.jpg', { alt: 'Nhân viên TRIP tại văn phòng', width: 1000, height: 1250, sizes: '(max-width: 860px) 92vw, 480px' }) %>
      <figcaption class="photo-caption"><img src="/img/logo-icon-sm.png" alt="" width="40" height="40"><span><strong>Trẻ · Đam mê · Tận tâm</strong>Đội ngũ TRIP Đà Nẵng</span></figcaption>
    </figure>
    <div class="reveal prose">
      <span class="eyebrow">Câu chuyện của chúng tôi</span>
      <h2 class="mt-0">Mỗi chuyến đi bắt đầu <em>nhẹ nhàng</em> cùng TRIP</h2>
      <p>TRIP ra đời với mong muốn giúp mỗi chuyến đi của bạn bắt đầu thật nhẹ nhàng, từ những thủ tục giấy tờ tưởng chừng phức tạp nhất.</p>
      <p>Chúng tôi tập trung vào hai thế mạnh: <strong>dịch vụ visa</strong> và <strong>dịch thuật công chứng</strong>. Visa và dịch thuật luôn đi cùng nhau, nên làm cả hai tại một nơi giúp hồ sơ của bạn đồng bộ, chính xác và nhanh hơn.</p>
      <p>Từ nền tảng đó, TRIP mở rộng thành hệ sinh thái du lịch trọn gói: hộ chiếu, vé máy bay, bảo hiểm, eSIM, tour, khách sạn và xe đưa đón. Bạn chỉ cần một đầu mối cho cả chuyến đi.</p>
    </div>
  </div>
</section>

<section class="section section--soft">
  <div class="container">
    <figure class="photo-banner reveal">
      <%- h.picture('/img/team/team-banner.jpg', { alt: 'Tập thể nhân viên TRIP', width: 1600, height: 686, sizes: '(max-width: 1200px) 100vw, 1160px' }) %>
      <figcaption><span class="eyebrow" style="color:#bfe3fa">Đội ngũ TRIP</span><strong>Những người đồng hành cùng hồ sơ của bạn</strong></figcaption>
    </figure>
    <div class="mt-4"><%- include('../partials/stats', { variant: 'inline' }) %></div>
    <div class="section-head reveal mt-4">
      <span class="eyebrow">Giá trị cốt lõi</span>
      <h2>Điều TRIP cam kết với bạn</h2>
    </div>
    <div class="grid grid--4">
      <div class="card reveal"><div class="card__icon"><%- icon('target') %></div><h3>Chính xác</h3><p>Tư vấn đúng loại visa, dịch đúng thuật ngữ, hồ sơ đầy đủ ngay từ đầu.</p></div>
      <div class="card reveal"><div class="card__icon"><%- icon('wallet') %></div><h3>Minh bạch</h3><p>Bảng giá công khai, nói rõ những gì đã và chưa bao gồm.</p></div>
      <div class="card reveal"><div class="card__icon"><%- icon('zap') %></div><h3>Nhanh chóng</h3><p>Phản hồi nhanh trong giờ làm việc, theo dõi sát tiến độ hồ sơ.</p></div>
      <div class="card reveal"><div class="card__icon"><%- icon('heart') %></div><h3>Tận tâm</h3><p>Đồng hành cùng bạn từ lúc chuẩn bị đến khi lên đường.</p></div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Đội ngũ tư vấn</span>
      <h2>Chuyên viên theo từng mảng dịch vụ</h2>
      <p>Mỗi thị trường visa và mảng dịch vụ đều có chuyên viên phụ trách riêng.</p>
    </div>
    <div class="grid grid--3">
      <div class="card reveal"><div class="card__icon"><%- icon('passport') %></div><h3>Visa</h3><ul class="consultants"><% company.consultants.visa.forEach(function (c) { %><li><a href="tel:<%= h.phoneTel(c.phone) %>"><%= c.name %> <span><%= h.phoneDisplay(c.phone) %></span></a></li><% }) %></ul></div>
      <div class="card reveal"><div class="card__icon"><%- icon('lang') %></div><h3>Dịch thuật</h3><ul class="consultants"><% company.consultants.translation.forEach(function (c) { %><li><a href="tel:<%= h.phoneTel(c.phone) %>"><%= c.name %> <span><%= h.phoneDisplay(c.phone) %></span></a></li><% }) %></ul></div>
      <div class="card reveal"><div class="card__icon"><%- icon('car') %></div><h3>Hộ chiếu · Xe · Tour</h3><ul class="consultants"><% company.consultants.car.forEach(function (c) { %><li><a href="tel:<%= h.phoneTel(c.phone) %>"><%= c.name %> <span><%= h.phoneDisplay(c.phone) %></span></a></li><% }) %></ul></div>
    </div>
    <div class="team-gallery mt-4">
      <figure class="photo-frame reveal"><%- h.picture('/img/team/thumbs-up.jpg', { alt: 'Nhân viên TRIP', width: 1000, height: 1000, sizes: '(max-width: 640px) 100vw, 380px' }) %></figure>
      <figure class="photo-frame reveal"><%- h.picture('/img/team/consultant.jpg', { alt: 'Tư vấn viên TRIP', width: 800, height: 1000, sizes: '(max-width: 640px) 100vw, 380px' }) %></figure>
      <figure class="photo-frame reveal"><%- h.picture('/img/team/team.jpg', { alt: 'Tập thể TRIP', width: 1400, height: 1050, sizes: '(max-width: 640px) 100vw, 380px' }) %></figure>
    </div>
    <p class="text-center muted small mt-2">Đội ngũ TRIP tại văn phòng 35 Cao Thắng, Đà Nẵng</p>
  </div>
</section>

<section class="section section--soft">
  <div class="container">
    <div class="grid grid--2">
      <div class="card reveal">
        <h3>Thông tin doanh nghiệp</h3>
        <ul class="checklist">
          <li><%- icon('check-circle') %><span><strong>Tên công ty:</strong> <%= company.legalName %></span></li>
          <li><%- icon('check-circle') %><span><strong>Mã số thuế:</strong> <%= company.taxCode %></span></li>
          <li><%- icon('check-circle') %><span><strong>Văn phòng:</strong> <%= company.address %></span></li>
          <li><%- icon('check-circle') %><span><strong>Email:</strong> <%= settings.email %></span></li>
          <li><%- icon('check-circle') %><span><strong>Fanpage:</strong> <a href="<%= settings.facebook %>" target="_blank" rel="noopener">facebook.com/triptranslate</a></span></li>
        </ul>
      </div>
      <div class="card reveal">
        <h3>Ghé thăm văn phòng</h3>
        <p>Đội ngũ TRIP luôn sẵn sàng tiếp đón bạn tại văn phòng trung tâm Đà Nẵng.</p>
        <ul class="checklist">
          <% company.hours.forEach(function (hr) { %><li><%- icon('clock') %><span><strong><%= hr.label %>:</strong> <%= hr.value %></span></li><% }) %>
        </ul>
        <div class="flex mt-3"><a class="btn btn--navy" href="/lien-he">Xem bản đồ</a><button class="btn btn--accent" data-open-lead>Đặt lịch tư vấn</button></div>
      </div>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
