<%- include('../partials/head') %>
<% const video = h.parseVideo(settings.hero_video); %>

<section class="hero hero--art">
  <div class="sparkles"><i style="top:12%;left:8%;--s:12px"></i><i style="top:22%;left:44%;--s:9px;--d:-1s"></i><i style="top:8%;left:62%;--s:16px;--d:-2s"></i><i style="top:40%;left:3%;--s:8px;--d:-.5s"></i><i style="top:30%;right:4%;--s:12px;--d:-2.5s"></i><i style="top:62%;left:48%;--s:10px;--d:-1.6s"></i></div>
  <div class="container">
    <div>
      <span class="eyebrow" style="color:#9fd3f5">TRIP Đà Nẵng · <%= company.slogan %></span>
      <h1>Chuyên visa <em>Trung · Hàn · Nhật</em> & Châu Âu</h1>
      <p class="hero__lead">Kèm dịch thuật công chứng Anh – Trung – Hàn – Nhật ngay tại văn phòng. TRIP lo trọn hồ sơ, bạn chỉ việc xếp vali.</p>
      <ul class="hero__markets">
        <% services.markets.forEach(function (m, i) { %>
          <li><a class="<%= i < 3 ? 'is-strong' : '' %>" href="/dich-vu/visa#<%= m.id %>"><img src="<%= flag(m.code) %>" alt="" width="28" height="28"><%= m.country %></a></li>
        <% }) %>
      </ul>
      <div class="hero__actions">
        <button class="btn btn--accent" data-open-lead data-service="Visa Trung Quốc"><%- icon('passport') %> Tư vấn visa miễn phí</button>
        <button class="btn btn--outline-white" data-open-lead data-service="Dịch thuật công chứng"><%- icon('lang') %> Báo giá dịch thuật</button>
      </div>
    </div>

    <div class="hero__visual">
      <svg class="flight-path" viewBox="0 0 500 560" aria-hidden="true"><path id="fp" d="M30 470 C 60 300, 160 360, 220 250 S 400 80, 480 60"/><path class="plane" d="M0 0l-12 5 3-5-3-5z" transform="translate(470 64) rotate(-18)"/></svg>
      <%- include('../partials/stamp', { top: 'VISA · CHINA · TRUNG QUỐC · ', mid: '中国', sub: 'APPROVED', cls: 'stamp--cn' }) %>
      <%- include('../partials/stamp', { top: 'VISA · KOREA · HÀN QUỐC · ', mid: '한국', sub: 'APPROVED', cls: 'stamp--kr' }) %>
      <%- include('../partials/stamp', { top: 'VISA · JAPAN · NHẬT BẢN · ', mid: '日本', sub: 'APPROVED', cls: 'stamp--jp' }) %>
      <%- include('../partials/stamp', { top: 'SCHENGEN · EUROPE · ', mid: 'EU', sub: 'APPROVED', cls: 'stamp--eu' }) %>
      <div class="porthole">
        <div class="porthole__glass">
          <% if (video && video.type === 'file') { %>
            <video id="hero-video" src="<%= video.src %>" autoplay muted loop playsinline preload="metadata"></video>
            <button class="btn btn--sm btn--white porthole__sound" id="hero-sound" type="button"><%- icon('volume') %> Bật tiếng</button>
          <% } else { %>
            <div class="porthole__sky">
              <span class="sun"></span>
              <svg viewBox="0 0 400 200" preserveAspectRatio="none"><path class="p1" d="M0 90c30-30 80-30 110 0 30-36 90-36 120 0 30-30 80-30 110 0 20-16 46-16 60 0V200H0z"/><path class="p2" d="M0 130c30-26 76-26 104 0 34-32 92-32 124 0 30-24 76-24 104 0 26-20 52-20 68 0V200H0z"/><path class="p3" d="M0 168c34-22 80-22 112 0 34-26 90-26 122 0 32-20 76-20 104 0 24-16 48-16 62 0V200H0z"/></svg>
            </div>
            <% if (video) { %>
              <button class="porthole__play" type="button" data-video-modal="<%= video.embed %>" aria-label="Xem video giới thiệu TRIP">
                <span><%- icon('play') %></span><span>Xem video về TRIP</span>
              </button>
            <% } %>
          <% } %>
        </div>
      </div>
    </div>
  </div>
  <%- include('../partials/clouds', { end: '#ffffff' }) %>
</section>

<div class="quick-lead">
  <div class="container">
    <div class="bpass">
      <div class="bpass__stub">
        <span class="bpass__label">Boarding pass · Miễn phí</span>
        <div class="bpass__route"><div><b>DAD</b><small>Đà Nẵng</small></div><%- icon('plane') %><div><b>✦</b><small>Thế giới</small></div></div>
        <span class="bpass__title">Tư vấn visa & dịch thuật</span>
      </div>
      <div class="bpass__form">
        <%- include('../partials/lead-form', { formId: 'quick', layout: 'inline', showNote: false, submitLabel: 'Gửi' }) %>
      </div>
    </div>
  </div>
</div>

<!-- Hai dịch vụ trọng tâm -->
<section class="section">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Dịch vụ trọng tâm</span>
      <h2>Hai thế mạnh làm nên <em>TRIP</em></h2>
      <p>Visa và Dịch thuật luôn đi cùng nhau. Làm cả hai tại một nơi giúp bạn tiết kiệm thời gian, chi phí và không lo sai lệch giấy tờ.</p>
    </div>
    <div class="pillars">
      <article class="pillar pillar--visa reveal">
        <span class="pillar__tag">Dịch vụ Visa</span>
        <%- include('../partials/stamp', { top: 'VISA · APPROVED · VISA · APPROVED · ', mid: 'TRIP', sub: '', cls: '' }) %>
        <h3>Visa <em style="color:#bfe3fa">Trung · Hàn · Nhật</em> & Châu Âu</h3>
        <p>Tư vấn đúng loại visa, chuẩn bị hồ sơ, đặt lịch hẹn và theo dõi đến khi có kết quả.</p>
        <ul>
          <li><%- icon('check') %> Trung Quốc: du lịch, thăm thân, thương mại, du học, kết hôn</li>
          <li><%- icon('check') %> Hàn Quốc 3 tháng, 5 năm, 10 năm · Nhật Bản single & multiple</li>
          <li><%- icon('check') %> Schengen & Anh, luyện phỏng vấn 1 kèm 1</li>
          <li><%- icon('check') %> Cùng Mỹ, Úc, Canada, Đài Loan, Hồng Kông, Dubai…</li>
        </ul>
        <div class="pillar__price">
          <div><small>Visa Trung Quốc chỉ từ</small><strong><%= h.vnd(services.chinaVisa.rows[0].price) %></strong></div>
          <a class="btn btn--white" href="/dich-vu/visa">Xem bảng giá visa <%- icon('arrow') %></a>
        </div>
      </article>
      <article class="pillar pillar--trans reveal">
        <span class="pillar__tag">Dịch thuật công chứng</span>
        <%- include('../partials/stamp', { top: 'CÔNG CHỨNG · CERTIFIED · ', mid: '译', sub: '', cls: '' }) %>
        <h3>Bản dịch <em style="color:#fff3d6">chuẩn</em>, có dấu, lấy nhanh</h3>
        <p>Dịch thuật công chứng dấu công ty và dấu tư pháp, hợp pháp hoá và chứng nhận lãnh sự cho mọi loại giấy tờ.</p>
        <ul>
          <li><%- icon('check') %> Anh, Trung, Hàn, Nhật, Thái, Lào và nhiều ngôn ngữ khác</li>
          <li><%- icon('check') %> Khai sinh, kết hôn, bằng cấp, học bạ, sao kê, hợp đồng…</li>
          <li><%- icon('check') %> Dịch hoả tốc, không theo form</li>
          <li><%- icon('check') %> Công chứng bản sao, in ấn, hiệu đính tại chỗ</li>
        </ul>
        <div class="pillar__price">
          <div><small>Dịch tiếng Anh chỉ từ</small><strong><%= h.vnd(services.translation.languages[0].rows[0].price) %>/trang</strong></div>
          <a class="btn btn--white" href="/dich-vu/dich-thuat">Xem bảng giá dịch thuật <%- icon('arrow') %></a>
        </div>
      </article>
    </div>
  </div>
</section>

<!-- Thị trường visa thế mạnh -->
<section class="section section--soft" id="visa">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Thị trường thế mạnh</span>
      <h2>Ba cửa ngõ <em>Á Đông</em>, một hành trình <em>trời Âu</em></h2>
      <p>Mỗi thị trường có chuyên viên phụ trách riêng. Giá trọn gói đã gồm phí lãnh sự, dịch thuật công chứng giấy tờ cơ bản và phí dịch vụ.</p>
    </div>
    <div class="markets">
      <% services.markets.slice(0, 3).forEach(function (m) { %>
        <a class="market market--<%= m.art %> reveal" href="/dich-vu/visa#<%= m.id %>">
          <div class="market__art">
            <span class="market__native"><%= m.native %></span>
            <%- include('../partials/art', { kind: m.art }) %>
          </div>
          <div class="market__body">
            <%- include('../partials/stamp', { top: 'TRIP · THẾ MẠNH · TRIP · THẾ MẠNH · ', mid: '✦', sub: '', cls: 'market__stamp' }) %>
            <span class="market__en">Visa <%= m.en %></span>
            <h3><%= m.country %></h3>
            <p><%= m.blurb %></p>
            <ul class="market__types"><% m.types.forEach(function (t) { %><li><%= t %></li><% }) %></ul>
            <div class="market__foot">
              <div><small>Trọn gói từ</small><strong><%= h.money(m.from) %></strong><span class="time"><%- icon('clock') %> <%= m.time %></span></div>
              <span class="market__go"><%- icon('arrow') %></span>
            </div>
          </div>
        </a>
      <% }) %>
    </div>
    <% const eu = services.markets[3]; %>
    <a class="market market--eu market--wide reveal" href="/dich-vu/visa#<%= eu.id %>">
      <div class="market__art">
        <span class="market__native"><%= eu.native %></span>
        <%- include('../partials/art', { kind: 'eu' }) %>
      </div>
      <div class="market__body">
        <span class="market__en">Visa <%= eu.en %></span>
        <h3>Visa <em class="serif" style="color:var(--sky-600)">Châu Âu</em></h3>
        <p><%= eu.blurb %></p>
        <ul class="market__types"><% eu.types.forEach(function (t) { %><li><%= t %></li><% }) %></ul>
        <div class="market__foot">
          <div><small>Trọn gói từ</small><strong><%= h.money(eu.from) %></strong><span class="time"><%- icon('clock') %> <%= eu.time %></span></div>
          <span class="market__go"><%- icon('arrow') %></span>
        </div>
      </div>
    </a>
    <div class="markets-note">
      <a class="btn btn--navy" href="/dich-vu/visa">Bảng giá visa đầy đủ <%- icon('arrow') %></a>
      <a class="btn btn--ghost" href="/dich-vu/visa#cac-nuoc-khac">Mỹ, Úc, Canada & nước khác</a>
    </div>
  </div>
</section>

<!-- Bảng giá dịch thuật rút gọn -->
<section class="section">
  <div class="container">
    <div class="why">
      <div class="reveal">
        <span class="eyebrow">Bảng giá dịch thuật</span>
        <h2>Giá rõ ràng <em>theo từng trang</em></h2>
        <p class="lead">Chọn ngôn ngữ để xem giá. Văn bản chuyên ngành sâu được báo giá riêng sau khi TRIP nhận tài liệu.</p>
        <ul class="checklist mt-3">
          <li><%- icon('check-circle') %> Nhận tài liệu qua Zalo, email hoặc tại văn phòng</li>
          <li><%- icon('check-circle') %> Báo giá và thời gian trả bản dịch trước khi làm</li>
          <li><%- icon('check-circle') %> Bảo mật thông tin giấy tờ cá nhân</li>
        </ul>
        <div class="flex mt-3">
          <button class="btn btn--accent" data-open-lead data-service="Dịch thuật công chứng">Nhận báo giá ngay</button>
          <a class="btn btn--ghost" href="/dich-vu/dich-thuat#bang-gia">Bảng giá đầy đủ</a>
        </div>
      </div>
      <div class="reveal" data-tabs>
        <div class="tabs" role="tablist" aria-label="Chọn ngôn ngữ">
          <% services.translation.languages.forEach(function (l, i) { %>
            <button class="tab" role="tab" id="tab-<%= l.id %>" aria-controls="panel-<%= l.id %>" aria-selected="<%= i === 0 %>"><%= l.label %></button>
          <% }) %>
        </div>
        <% services.translation.languages.forEach(function (l, i) { %>
          <div class="tab-panel" role="tabpanel" id="panel-<%= l.id %>" aria-labelledby="tab-<%= l.id %>" <%= i === 0 ? '' : 'hidden' %>>
            <ul class="price-list">
              <% l.rows.forEach(function (r) { %>
                <li><span><%= r.level %><br><small><%= l.pair %></small></span><strong><%= r.price ? h.vnd(r.price) : r.text %><% if (r.price) { %><small> /trang</small><% } %></strong></li>
              <% }) %>
            </ul>
          </div>
        <% }) %>
      </div>
    </div>
  </div>
</section>

<!-- Quy trình -->
<section class="section section--soft">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Quy trình làm việc</span>
      <h2>4 bước, từ <em>hồ sơ</em> đến <em>cửa máy bay</em></h2>
    </div>
    <ol class="steps">
      <li class="step reveal"><div class="card__icon"><%- icon('chat') %></div><h3>Tư vấn miễn phí</h3><p>Gọi hotline, nhắn Zalo hoặc để lại thông tin. TRIP tư vấn loại visa và giấy tờ cần thiết.</p></li>
      <li class="step reveal"><div class="card__icon"><%- icon('file') %></div><h3>Chuẩn bị hồ sơ</h3><p>Kiểm tra giấy tờ, dịch thuật công chứng, khai form và đặt lịch hẹn cho bạn.</p></li>
      <li class="step reveal"><div class="card__icon"><%- icon('send') %></div><h3>Nộp & theo dõi</h3><p>Nộp hồ sơ tại Lãnh sự quán / trung tâm tiếp nhận, cập nhật tiến độ thường xuyên.</p></li>
      <li class="step reveal"><div class="card__icon"><%- icon('award') %></div><h3>Nhận kết quả</h3><p>Nhận hộ chiếu và visa, kèm tư vấn vé máy bay, bảo hiểm, eSIM cho chuyến đi.</p></li>
    </ol>
  </div>
</section>

<!-- Dịch vụ khác -->
<section class="section">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Hệ sinh thái du lịch</span>
      <h2>Một đầu mối cho <em>cả chuyến đi</em></h2>
      <p>Ngoài visa và dịch thuật, TRIP hỗ trợ trọn gói mọi dịch vụ bạn cần.</p>
    </div>
    <div class="grid grid--3">
      <% Object.values(services.otherServices).forEach(function (s) { %>
        <a class="card card--link svc-mini reveal" href="/dich-vu/<%= s.slug %>">
          <div class="card__icon"><%- icon(s.icon) %></div>
          <div><h3><%= s.title %></h3><p><%= s.short %></p></div>
        </a>
      <% }) %>
      <a class="card card--link svc-mini reveal" href="/dich-vu/dich-thuat#hop-phap-hoa">
        <div class="card__icon"><%- icon('stamp') %></div>
        <div><h3>Hợp pháp hoá lãnh sự</h3><p>Chứng nhận, hợp pháp hoá lãnh sự giấy tờ dân sự và kinh tế.</p></div>
      </a>
    </div>
  </div>
</section>

<!-- Tour -->
<% if (tours.length) { %>
<section class="section section--soft">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Tour nổi bật</span>
      <h2>Khởi hành từ <em>Đà Nẵng</em></h2>
      <p>Tour trọn gói kèm hỗ trợ visa. Đăng ký nhận tin để không bỏ lỡ lịch khởi hành mới mỗi tháng.</p>
    </div>
    <div class="grid grid--4">
      <% tours.forEach(function (t) { %><%- include('../partials/tour-card', { t }) %><% }) %>
    </div>
    <div class="flex mt-4" style="justify-content:center">
      <a class="btn btn--navy" href="/tour">Xem tất cả tour <%- icon('arrow') %></a>
      <button class="btn btn--ghost" data-open-news><%- icon('mail') %> Nhận lịch tour hàng tháng</button>
    </div>
  </div>
</section>
<% } %>

<!-- Vì sao chọn TRIP -->
<section class="section">
  <div class="container why">
    <div class="why__visual reveal"><img src="/img/logo-vertical.png" alt="Logo TRIP" width="400" height="400"></div>
    <div class="reveal">
      <span class="eyebrow">Vì sao chọn TRIP</span>
      <h2>Tận tâm trên <em>từng hồ sơ</em> của bạn</h2>
      <div class="why__list mt-3">
        <div class="why__item"><div class="card__icon"><%- icon('target') %></div><div><h3>Trọn gói, một đầu mối</h3><p>Visa, dịch thuật, vé máy bay, bảo hiểm, tour… tất cả tại một nơi, không phải chạy nhiều chỗ.</p></div></div>
        <div class="why__item"><div class="card__icon"><%- icon('wallet') %></div><div><h3>Giá cạnh tranh, minh bạch</h3><p>Bảng giá công khai, báo rõ những gì đã bao gồm và chưa bao gồm trước khi làm.</p></div></div>
        <div class="why__item"><div class="card__icon"><%- icon('users') %></div><div><h3>Tư vấn viên theo từng thị trường</h3><p>Có chuyên viên riêng cho hồ sơ Trung Quốc, Nhật Bản, Hàn Quốc và Âu – Mỹ – Úc.</p></div></div>
        <div class="why__item"><div class="card__icon"><%- icon('pin') %></div><div><h3>Văn phòng ngay trung tâm Đà Nẵng</h3><p>Gặp trực tiếp tại 35 Cao Thắng, Hải Châu. Nhận và trả hồ sơ thuận tiện.</p></div></div>
      </div>
    </div>
  </div>
</section>

<!-- Blog -->
<% if (posts.length) { %>
<section class="section section--soft">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Cẩm nang</span>
      <h2>Kinh nghiệm <em>visa & dịch thuật</em></h2>
    </div>
    <div class="grid grid--3">
      <% posts.forEach(function (p) { %><%- include('../partials/post-card', { p }) %><% }) %>
    </div>
    <p class="text-center mt-4"><a class="btn btn--ghost" href="/blog">Xem tất cả bài viết <%- icon('arrow') %></a></p>
  </div>
</section>
<% } %>

<!-- CTA cuối -->
<section class="section section--navy" id="tu-van">
  <div class="container cta-band">
    <div class="reveal">
      <span class="eyebrow" style="color:#9fd3f5">Bắt đầu hành trình</span>
      <h2>Sẵn sàng cho <em>chuyến đi tiếp theo</em>?</h2>
      <p>Để lại thông tin hoặc gọi trực tiếp. Tư vấn viên TRIP sẽ kiểm tra hồ sơ và báo giá miễn phí cho bạn.</p>
      <ul class="contact-lines">
        <li><div class="card__icon"><%- icon('passport') %></div><div><strong>Visa & Tour</strong><a href="tel:<%= h.phoneTel(settings.hotline) %>"><%= h.phoneDisplay(settings.hotline) %></a></div></li>
        <li><div class="card__icon"><%- icon('lang') %></div><div><strong>Dịch thuật</strong><a href="tel:<%= h.phoneTel(settings.hotline_translation) %>"><%= h.phoneDisplay(settings.hotline_translation) %></a></div></li>
        <li><div class="card__icon"><%- icon('pin') %></div><div><strong>Văn phòng</strong><span><%= company.address %></span></div></li>
      </ul>
    </div>
    <div class="cta-band__form reveal">
      <h3>Đăng ký tư vấn miễn phí</h3>
      <%- include('../partials/lead-form', { formId: 'cta', layout: 'stack' }) %>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
