<%- include('../partials/head') %>
<% const video = h.parseVideo(settings.hero_video); const teaser = h.parseVideo(settings.hero_teaser); %>

<section class="hero hero--video">
  <video class="hero__bg" data-src="/media/hero-montage.mp4" poster="/media/hero-montage.jpg" muted loop playsinline preload="none" aria-hidden="true"></video>
  <div class="hero__shade"></div>
  <div class="container">
    <div>
      <span class="eyebrow" style="color:#bfe3fa">TRIP Đà Nẵng · <%= company.slogan %></span>
      <h1>Visa & Dịch thuật <em>trọn gói</em>, nhanh gọn ngay tại Đà Nẵng</h1>
      <p class="hero__lead">Từ hồ sơ visa Trung Quốc, Hàn Quốc, Nhật Bản, Châu Âu đến bản dịch công chứng Anh – Trung – Hàn – Nhật. TRIP lo trọn thủ tục để bạn yên tâm lên đường.</p>
      <ul class="hero__markets">
        <% services.markets.forEach(function (m, i) { %>
          <li><a class="<%= i < 3 ? 'is-strong' : '' %>" href="/visa/<%= m.id %>"><img src="<%= flag(m.code) %>" alt="" width="28" height="28">Visa <%= m.country %></a></li>
        <% }) %>
      </ul>
      <div class="hero__actions">
        <button class="btn btn--accent" data-open-lead data-service="Visa Trung Quốc"><%- icon('passport') %> Tư vấn visa</button>
        <button class="btn btn--outline-white" data-open-lead data-service="Dịch thuật công chứng"><%- icon('lang') %> Báo giá dịch thuật</button>
      </div>
    </div>

    <div class="hero__visual">
      <% if (video) { %>
      <p class="hero__callout" aria-hidden="true">
        <span>Click vào đây để biết thêm về TRIP!</span>
        <svg class="hero__arrow" viewBox="0 0 160 120" fill="none"><path d="M8 14 C 60 4, 120 22, 132 80" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-dasharray="1 0"/><path d="M116 70 L 133 92 L 147 66" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </p>
      <% } %>
      <%- include('../partials/stamp', { top: 'VISA · CHINA · TRUNG QUỐC · ', mid: '中国', sub: 'APPROVED', cls: 'stamp--cn' }) %>
      <%- include('../partials/stamp', { top: 'VISA · KOREA · HÀN QUỐC · ', mid: '한국', sub: 'APPROVED', cls: 'stamp--kr' }) %>
      <%- include('../partials/stamp', { top: 'VISA · JAPAN · NHẬT BẢN · ', mid: '日本', sub: 'APPROVED', cls: 'stamp--jp' }) %>
      <%- include('../partials/stamp', { top: 'SCHENGEN · EUROPE · ', mid: 'EU', sub: 'APPROVED', cls: 'stamp--eu' }) %>
      <div class="porthole">
        <div class="porthole__glass">
          <img class="porthole__thumb" src="/media/trip-thumb.jpg" alt="" width="720" height="960" fetchpriority="high">
          <% if (teaser) { %>
            <video class="porthole__teaser" src="<%= teaser.src %>" muted loop playsinline preload="none" aria-hidden="true"></video>
          <% } %>
          <% if (video) { %>
            <button class="porthole__play" type="button" data-video-modal="<%= video.type === 'file' ? video.src : video.embed %>" data-video-type="<%= video.type %>" aria-label="Xem video giới thiệu về TRIP">
              <span class="porthole__btn"><%- icon('play') %></span>
              <span class="porthole__label"><small>Video giới thiệu · 4:14</small>Gặp gỡ đội ngũ <em>TRIP</em></span>
            </button>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</section>

<div class="quick-lead">
  <div class="container">
    <div class="bpass">
      <div class="bpass__stub">
        <span class="bpass__label">Boarding pass · Miễn phí</span>
        <div class="bpass__route"><div><b>DAD</b><small>Đà Nẵng</small></div><%- icon('plane') %><div><b>✦</b><small>Thế giới</small></div></div>
        <span class="bpass__title">Tư vấn visa & dịch thuật</span>
      </div>
      <div class="bpass__form">
        <%- include('../partials/lead-form', { formId: 'quick', layout: 'inline', showNote: false, submitLabel: 'Gửi' }) %>
      </div>
    </div>
  </div>
</div>

<!-- Thành tích -->
<section class="section section--stats">
  <div class="container">
    <p class="stats__lead reveal">5 năm qua, hơn <strong>10.000</strong> giấc mơ xuất ngoại đã thành hiện thực cùng TRIP</p>
    <%- include('../partials/stats', { variant: 'band' }) %>
  </div>
</section>

<!-- Dịch vụ nổi bật -->
<section class="section section--soft">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Dịch vụ nổi bật</span>
      <h2>Visa <em>Trung · Hàn · Nhật</em> & Châu Âu</h2>
      <p>Giá trọn gói đã gồm phí lãnh sự, dịch thuật công chứng giấy tờ cơ bản và phí dịch vụ.</p>
    </div>
    <div class="markets markets--4">
      <% services.markets.forEach(function (m, i) { %>
        <a class="market market--<%= m.art %> reveal" href="/visa/<%= m.id %>">
          <div class="market__art">
            <video class="js-inview" src="/media/markets/<%= m.art %>.mp4" poster="/media/markets/<%= m.art %>.jpg" muted loop playsinline preload="none" aria-hidden="true"></video>
            <span class="market__native"><%= m.native %></span>
            <% if (i < 3) { %><span class="market__badge">✦ Thế mạnh</span><% } %>
          </div>
          <div class="market__body">
            <span class="market__en">Visa <%= m.en %></span>
            <h3><%= m.country %></h3>
            <div class="market__foot">
              <div><small>Trọn gói từ</small><strong><%= h.money(m.from) %></strong><span class="time"><%- icon('clock') %> <%= m.time %></span></div>
              <span class="market__go"><%- icon('arrow') %></span>
            </div>
          </div>
        </a>
      <% }) %>
    </div>

    <a class="feature-band reveal" href="/dich-vu/dich-thuat">
      <div class="feature-band__icon"><%- icon('lang') %></div>
      <div class="feature-band__text">
        <span class="market__en">Dịch thuật công chứng</span>
        <h3>Bản dịch <em>chuẩn</em>, có dấu, lấy nhanh</h3>
        <p>Anh · Trung · Hàn · Nhật · Thái · Lào. Công chứng dấu công ty, dấu tư pháp, hợp pháp hoá lãnh sự.</p>
      </div>
      <div class="feature-band__price"><small>Chỉ từ</small><strong><%= h.vnd(services.translation.languages[0].rows[0].price) %></strong><small>/trang</small></div>
      <span class="market__go"><%- icon('arrow') %></span>
    </a>

    <div class="markets-note">
      <a class="btn btn--navy" href="/visa">Xem tất cả dịch vụ visa <%- icon('arrow') %></a>
      <a class="btn btn--ghost" href="/dich-vu">Dịch vụ khác</a>
    </div>
  </div>
</section>

<!-- Tour nổi bật -->
<% if (tours.length) { %>
<section class="section">
  <div class="container">
    <div class="section-top reveal">
      <div><span class="eyebrow">Tour nổi bật</span><h2>Khởi hành từ <em>Đà Nẵng</em></h2></div>
      <a class="btn btn--ghost" href="/tour">Xem tất cả tour <%- icon('arrow') %></a>
    </div>
    <div class="grid grid--4 tours-scroll">
      <% tours.forEach(function (t) { %><%- include('../partials/tour-card', { t }) %><% }) %>
    </div>
  </div>
</section>
<% } %>

<!-- Đánh giá của khách (chỉ hiện khi đã có đánh giá thật được duyệt) -->
<% if (reviews.length) { %>
<section class="section">
  <div class="container">
    <div class="section-top reveal">
      <div><span class="eyebrow">Đánh giá</span><h2>Khách hàng nói gì về <em>TRIP</em></h2></div>
      <a class="btn btn--ghost" href="/danh-gia">Xem tất cả đánh giá <%- icon('arrow') %></a>
    </div>
    <div class="reviews-grid"><% reviews.slice(0, 3).forEach(function (r) { %><%- include('../partials/review-card', { r }) %><% }) %></div>
  </div>
</section>
<% } %>

<!-- Về TRIP (ngắn) -->
<section class="section section--soft">
  <div class="container why">
    <figure class="photo-frame photo-frame--tilt reveal">
      <img src="/img/team/team.jpg" alt="Đội ngũ nhân viên TRIP tại văn phòng Đà Nẵng" width="1400" height="1050" loading="lazy">
      <figcaption class="photo-caption"><img src="/img/logo-icon-sm.png" alt="" width="40" height="40"><span><strong>Đội ngũ TRIP</strong>Văn phòng 35 Cao Thắng, Đà Nẵng</span></figcaption>
    </figure>
    <div class="reveal">
      <span class="eyebrow">Về TRIP</span>
      <h2>Tận tâm trên <em>từng hồ sơ</em> của bạn</h2>
      <ul class="checklist mt-3">
        <li><%- icon('check-circle') %><span><strong>Trọn gói, một đầu mối:</strong> visa, dịch thuật, vé máy bay, bảo hiểm, tour.</span></li>
        <li><%- icon('check-circle') %><span><strong>Giá minh bạch:</strong> báo rõ những gì đã và chưa bao gồm.</span></li>
        <li><%- icon('check-circle') %><span><strong>Chuyên viên riêng</strong> cho từng thị trường visa.</span></li>
      </ul>
      <div class="flex mt-3"><a class="btn btn--navy" href="/gioi-thieu">Tìm hiểu về TRIP <%- icon('arrow') %></a></div>
    </div>
  </div>
</section>

<!-- CTA cuối -->
<section class="section section--navy" id="tu-van">
  <div class="container cta-band">
    <div class="reveal">
      <span class="eyebrow" style="color:#9fd3f5">Bắt đầu hành trình</span>
      <h2>Sẵn sàng cho <em>chuyến đi tiếp theo</em>?</h2>
      <p>Để lại thông tin hoặc gọi trực tiếp. Tư vấn viên TRIP sẽ kiểm tra hồ sơ và báo giá miễn phí cho bạn.</p>
      <ul class="contact-lines">
        <li><div class="card__icon"><%- icon('passport') %></div><div><strong>Visa & Tour</strong><a href="tel:<%= h.phoneTel(settings.hotline) %>"><%= h.phoneDisplay(settings.hotline) %></a></div></li>
        <li><div class="card__icon"><%- icon('lang') %></div><div><strong>Dịch thuật</strong><a href="tel:<%= h.phoneTel(settings.hotline_translation) %>"><%= h.phoneDisplay(settings.hotline_translation) %></a></div></li>
        <li><div class="card__icon"><%- icon('pin') %></div><div><strong>Văn phòng</strong><span><%= company.address %></span></div></li>
      </ul>
    </div>
    <div class="cta-band__form reveal">
      <h3>Đăng ký tư vấn miễn phí</h3>
      <%- include('../partials/lead-form', { formId: 'cta', layout: 'stack' }) %>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
