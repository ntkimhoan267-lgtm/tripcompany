<%- include('../partials/head') %>
<% const tr = services.translation; %>
<%- include('../partials/page-hero', {
  crumbs: [{ label: 'Dịch vụ', href: '/dich-vu' }, { label: 'Dịch thuật', href: '/dich-vu/dich-thuat' }, { label: 'Hợp pháp hoá lãnh sự' }],
  heading: 'Hợp pháp hoá &',
  headingEm: 'Chứng nhận lãnh sự',
  sub: 'Giấy tờ Việt Nam dùng ở nước ngoài (và ngược lại) thường phải được chứng nhận hoặc hợp pháp hoá lãnh sự. TRIP làm trọn gói, kèm dịch thuật công chứng.',
  actions: { service: 'Hợp pháp hoá lãnh sự', phone: settings.hotline_translation },
  visual: '/img/services/hop-phap-hoa.jpg',
  stamp: { top: 'LEGALIZED · CONSULAR · ', mid: '✓', sub: 'TRIP', cls: 'stamp--hero stamp--eu' },
  facts: [{ icon: 'wallet', label: 'Trọn gói từ', value: h.vnd(tr.legalization[0].price) }, { icon: 'stamp', label: 'Gói giấy tờ kinh tế', value: 'Đã gồm tem đỏ' }],
}) %>

<section class="section">
  <div class="container layout-side">
    <div class="stack stack--lg">
      <div class="feature-trio">
        <div class="feature-trio__item"><span><%- icon('heart') %></span><h3>Giấy tờ dân sự</h3><p>Xác nhận độc thân, khai sinh, đăng ký kết hôn, lý lịch tư pháp…</p></div>
        <div class="feature-trio__item"><span><%- icon('book') %></span><h3>Giấy tờ học thuật</h3><p>Bằng cấp, bảng điểm, học bạ cho hồ sơ du học, xin việc.</p></div>
        <div class="feature-trio__item"><span><%- icon('file') %></span><h3>Giấy tờ kinh tế</h3><p>Hợp đồng lao động, hợp đồng thương mại, giấy tờ công ty.</p></div>
      </div>

      <div>
        <div class="block-head"><span class="eyebrow">Bảng giá</span><h2>Chứng nhận lãnh sự <em>Trung Quốc</em></h2></div>
        <%- include('../partials/price/options', { items: tr.legalization.map(function (x) { return { title: x.name, tag: x.detail, price: h.vnd(x.price), flag: 'cn' }; }), service: 'Hợp pháp hoá lãnh sự' }) %>
        <p class="ppanel__note"><%- icon('info') %>Hợp pháp hoá lãnh sự cho các nước khác: vui lòng liên hệ để được báo giá theo loại giấy tờ và quốc gia sử dụng.</p>
      </div>

      <div>
        <div class="block-head"><span class="eyebrow">Quy trình</span><h2>Từ giấy tờ đến <em>con dấu</em></h2></div>
        <ol class="timeline">
          <li><span><%- icon('send') %></span><h3>Gửi giấy tờ</h3><p>Gửi bản chụp để TRIP kiểm tra loại giấy tờ và nơi sử dụng.</p></li>
          <li><span><%- icon('lang') %></span><h3>Dịch thuật công chứng</h3><p>Dịch và công chứng theo yêu cầu của cơ quan nước ngoài.</p></li>
          <li><span><%- icon('stamp') %></span><h3>Nộp chứng nhận</h3><p>Nộp tại Cục Lãnh sự / Sở Ngoại vụ và Đại sứ quán liên quan.</p></li>
          <li><span><%- icon('check-circle') %></span><h3>Bàn giao</h3><p>Nhận tại văn phòng hoặc gửi chuyển phát tận nơi.</p></li>
        </ol>
      </div>
    </div>
    <aside class="sidebar">
      <%- include('../partials/consult-box', { people: company.consultants.translation, presetService: 'Hợp pháp hoá lãnh sự' }) %>
    </aside>
  </div>
</section>

<%- include('../partials/footer') %>
