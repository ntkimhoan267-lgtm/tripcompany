<%- include('../partials/head') %>
<%
  const HERO = {
    'ho-chieu': { img: '/img/services/ho-chieu.jpg', stamp: { top: 'PASSPORT · HỘ CHIẾU · ', mid: 'VN', cls: 'stamp--cn' } },
    've-may-bay': { img: '/img/services/ve-may-bay.jpg', stamp: { top: 'BOARDING · DAD · ', mid: '✈', cls: 'stamp--kr' } },
    tour: { img: '/img/tours/ba-na.jpg', stamp: { top: 'DA NANG · HOI AN · HUE · ', mid: 'TOUR', cls: 'stamp--eu' } },
    'thue-xe': { img: '/img/services/thue-xe.jpg', stamp: { top: 'DA NANG · TRANSFER · ', mid: 'CAR', cls: 'stamp--kr' } },
    'bao-hiem-esim': { img: '/img/services/bao-hiem.jpg', stamp: { top: 'TRAVEL · INSURANCE · ESIM · ', mid: '✓', cls: 'stamp--jp' } },
  };
  const hero = HERO[svc.slug] || { img: '/img/services/thue-xe.jpg', stamp: { top: 'TRIP · ĐÀ NẴNG · ', mid: 'TRIP', cls: 'stamp--kr' } };
  hero.stamp = Object.assign({ sub: 'TRIP' }, hero.stamp, { cls: 'stamp--hero ' + hero.stamp.cls });
%>
<%- include('../partials/page-hero', {
  crumbs: [{ label: 'Dịch vụ', href: '/dich-vu' }, { label: svc.title }],
  heading: svc.title,
  sub: svc.intro,
  actions: { service: svc.leadService },
  visual: hero.img,
  stamp: hero.stamp,
}) %>

<section class="section">
  <div class="container layout-side">
    <div class="stack stack--lg">
      <% if (svc.slug === 'ho-chieu') { %>
        <div class="feature-trio">
          <div class="feature-trio__item"><span><%- icon('file') %></span><h3>Tư vấn giấy tờ</h3><p>Hướng dẫn chuẩn bị đúng giấy tờ, tránh đi lại nhiều lần.</p></div>
          <div class="feature-trio__item"><span><%- icon('send') %></span><h3>Nộp hồ sơ hộ</h3><p>TRIP khai tờ khai và nộp hồ sơ thay bạn.</p></div>
          <div class="feature-trio__item"><span><%- icon('passport') %></span><h3>Nhận tận nơi</h3><p>Hỗ trợ chuyển phát hộ chiếu khi có kết quả.</p></div>
        </div>
        <div class="block-head mt-4"><span class="eyebrow">Bảng giá</span><h2>Phí dịch vụ <em>hộ chiếu</em></h2></div>
        <%- include('../partials/price/options', { items: services.passport.rows.map(function (r) { return { title: r.type, time: r.time, price: h.vnd(r.price), flag: 'vn' }; }), service: 'Hộ chiếu' }) %>
        <div class="notice mt-2"><%- icon('info') %><div><% services.passport.notes.forEach(function (n) { %><div><%= n %></div><% }) %></div></div>

      <% } else if (svc.slug === 've-may-bay') { %>
        <div class="feature-trio">
          <div class="feature-trio__item"><span><%- icon('plane') %></span><h3>Nội địa & quốc tế</h3><p>Tìm chuyến bay phù hợp lịch trình và ngân sách.</p></div>
          <div class="feature-trio__item"><span><%- icon('ticket') %></span><h3>Vé tàu</h3><p>Đặt vé tàu Bắc – Nam và các tuyến du lịch.</p></div>
          <div class="feature-trio__item"><span><%- icon('chat') %></span><h3>Hỗ trợ đổi – hoàn</h3><p>Hỗ trợ đổi ngày, hoàn vé theo điều kiện từng hãng.</p></div>
        </div>
        <div class="block-head mt-4"><span class="eyebrow">Hãng bay</span><h2>TRIP hỗ trợ <em>đặt vé</em></h2></div>
        <ul class="chips"><% services.airlines.forEach(function (a) { %><li><%= a %></li><% }) %></ul>
        <div class="notice mt-3"><%- icon('info') %><div>Giá vé thay đổi theo thời điểm đặt và hạng ghế. Gửi yêu cầu để TRIP báo giá chính xác nhất cho hành trình của bạn.</div></div>

      <% } else if (svc.slug === 'tour') { %>
        <% if (tours.length) { %>
          <div class="grid grid--2"><% tours.forEach(function (t) { %><%- include('../partials/tour-card', { t }) %><% }) %></div>
          <p class="mt-3"><a class="btn btn--navy" href="/tour">Xem tất cả tour <%- icon('arrow') %></a></p>
        <% } %>
        <div class="block-head mt-4"><span class="eyebrow">Vé vui chơi</span><h2>Đà Nẵng – <em>Hội An</em></h2></div>
        <ul class="chips"><% services.attractions.forEach(function (a) { %><li><%= a %></li><% }) %></ul>
        <p class="table-note">Liên hệ để nhận giá vé tốt và combo vé + xe đưa đón.</p>

      <% } else if (svc.slug === 'thue-xe') { %>
        <div class="block-head"><span class="eyebrow"><%= services.carTransfer.area %></span><h2>Xe <em>đưa đón</em></h2></div>
        <%- include('../partials/price/cars') %>
        <div class="block-head mt-4"><span class="eyebrow">Giao xe tại Đà Nẵng</span><h2>Thuê xe <em>tự lái</em></h2></div>
        <div class="feature-trio">
          <% services.carTransfer.selfDrive.forEach(function (c) { %>
            <div class="feature-trio__item"><span><%- icon('car') %></span><h3><%= c.car %></h3><p><%= c.seats %></p><p class="mt-2"><strong style="color:var(--navy);font-size:1.2rem"><%= h.vnd(c.price) %></strong> <span class="muted">/ngày</span></p></div>
          <% }) %>
        </div>
        <div class="notice mt-2"><%- icon('info') %><div><% services.carTransfer.notes.forEach(function (n) { %><div><%= n %></div><% }) %></div></div>

      <% } else if (svc.slug === 'bao-hiem-esim') { %>
        <div class="feature-trio feature-trio--2">
          <div class="feature-trio__item"><span><%- icon('shield') %></span><h3>Bảo hiểm du lịch quốc tế</h3>
            <p>Bảo hiểm du lịch của Liberty, đáp ứng yêu cầu hồ sơ visa Schengen. Chi trả chi phí y tế, tai nạn, hành lý và hoãn chuyến (theo quyền lợi từng gói).</p></div>
          <div class="feature-trio__item"><span><%- icon('sim') %></span><h3>eSIM du lịch</h3>
            <p>eSIM data cho nhiều quốc gia: cài đặt qua mã QR trước khi bay, có internet ngay khi hạ cánh, giữ nguyên số điện thoại Việt Nam.</p></div>
        </div>
        <div class="notice mt-3"><%- icon('info') %><div>Phí bảo hiểm và gói eSIM phụ thuộc điểm đến và số ngày. Liên hệ TRIP để được tư vấn gói phù hợp.</div></div>
      <% } %>
    </div>

    <aside class="sidebar">
      <%- include('../partials/consult-box', { people: company.consultants[svc.consultants] || [], presetService: svc.leadService }) %>
    </aside>
  </div>
</section>

<%- include('../partials/footer') %>
