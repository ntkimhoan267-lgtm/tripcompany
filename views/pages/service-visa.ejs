<%- include('../partials/head') %>
<%- include('../partials/page-hero', {
  crumbs: [{ label: 'Dịch vụ', href: '/dich-vu' }, { label: 'Visa' }],
  heading: 'Dịch vụ Visa trọn gói',
  sub: 'Thế mạnh Trung Quốc, Hàn Quốc, Nhật Bản và Châu Âu, cùng Mỹ, Úc, Canada và nhiều quốc gia khác. Tư vấn đúng loại visa, chuẩn bị hồ sơ, đặt lịch, luyện phỏng vấn và theo dõi đến khi có kết quả.',
  actions: { service: 'Visa Trung Quốc' },
}) %>
<%
  const M = Object.fromEntries(services.markets.map(m => [m.id, m]));
  const rowsBy = (fn) => services.worldVisa.filter(fn);
  const kr = rowsBy(v => v.code === 'kr');
  const jp = rowsBy(v => v.code === 'jp');
  const eu = rowsBy(v => v.region === 'chau-au');
  const others = rowsBy(v => !['kr', 'jp'].includes(v.code) && v.region !== 'chau-au');
  const priceOf = (v) => v.vnd ? h.vnd(v.vnd) : h.usd(v.usd);
%>

<section class="section">
  <div class="container layout-side">
    <div>
      <nav class="jump" aria-label="Chọn thị trường">
        <% services.markets.forEach(function (m) { %><a href="#<%= m.id %>"><img src="<%= flag(m.code) %>" alt="" width="26" height="26"><%= m.country %></a><% }) %>
        <a href="#cac-nuoc-khac"><img src="<%= flag('us') %>" alt="" width="26" height="26">Mỹ · Úc · nước khác</a>
        <a href="#e-visa"><img src="<%= flag('vn') %>" alt="" width="26" height="26">E-visa Việt Nam</a>
      </nav>

      <% function head(m, strong) { %>
        <div class="market-head market--<%= m.art %>" id="<%= m.id %>">
          <div class="market-head__art"><%- include('../partials/art', { kind: m.art }) %></div>
          <div>
            <h2>Visa <%= m.country %> <span class="serif" style="font-weight:600;color:var(--muted);font-size:.7em"><%= m.native %></span><% if (strong) { %><span class="badge-strong">Thế mạnh</span><% } %></h2>
            <p><%= m.blurb %></p>
          </div>
        </div>
      <% } %>

      <% head(M['trung-quoc'], true) %>
      <div class="table-wrap">
        <table class="table">
          <thead><tr><th>Loại visa</th><th>Thời gian xét duyệt</th><th>Lưu trú / nhập cảnh</th><th class="num">Giá trọn gói</th></tr></thead>
          <tbody><% services.chinaVisa.rows.forEach(function (r) { %><tr><td><strong><%= r.type %></strong></td><td><%= r.time %></td><td class="muted"><%= r.detail %></td><td class="num"><%= h.vnd(r.price) %></td></tr><% }) %></tbody>
        </table>
      </div>
      <p class="table-note"><%= services.chinaVisa.note %> Cần chứng nhận lãnh sự giấy tờ dùng tại Trung Quốc? Xem <a href="/dich-vu/dich-thuat#hop-phap-hoa">tại đây</a>.</p>

      <% [['han-quoc', kr], ['nhat-ban', jp]].forEach(function ([id, rows]) { head(M[id], true) %>
        <div class="table-wrap">
          <table class="table">
            <thead><tr><th>Loại visa</th><th>Thời gian xét duyệt</th><th>Ghi chú</th><th class="num">Giá trọn gói</th></tr></thead>
            <tbody><% rows.forEach(function (v) { %><tr><td><strong><%= v.type %></strong></td><td><%= v.time %></td><td class="muted"><%= v.note || '' %></td><td class="num"><%= priceOf(v) %></td></tr><% }) %></tbody>
          </table>
        </div>
        <div class="flex mt-2"><button class="btn btn--sm btn--accent" data-open-lead data-service="<%= M[id].leadService %>">Tư vấn visa <%= M[id].country %></button></div>
      <% }) %>

      <% head(M['chau-au'], false) %>
      <div class="table-wrap">
        <table class="table">
          <thead><tr><th>Quốc gia</th><th>Loại visa</th><th>Thời gian</th><th class="num">Giá trọn gói</th></tr></thead>
          <tbody><% eu.forEach(function (v) { %>
            <tr><td><span class="table__country"><img src="<%= flag(v.code) %>" alt="" width="28" height="20" loading="lazy"><%= v.country %></span></td><td><%= v.type %><% if (v.note) { %><br><span class="muted"><%= v.note %></span><% } %></td><td><%= v.time %></td><td class="num"><%= priceOf(v) %></td></tr>
          <% }) %></tbody>
        </table>
      </div>
      <p class="table-note">Đã gồm luyện phỏng vấn 1 kèm 1. Bảo hiểm du lịch bắt buộc với khối Schengen, TRIP có sẵn gói của Liberty.</p>

      <div class="market-head" id="cac-nuoc-khac">
        <div class="market-head__art" style="background:linear-gradient(180deg,#eef6fb,#cfe3f2);display:grid;place-items:center;color:var(--navy)"><%- icon('globe') %></div>
        <div><h2>Mỹ · Úc · Canada & nước khác</h2><p>Hoa Kỳ, Canada, Úc, New Zealand, Đài Loan, Hồng Kông, Macau, Ấn Độ, Dubai…</p></div>
      </div>
      <div class="table-wrap">
        <table class="table">
          <thead><tr><th>Quốc gia</th><th>Loại visa</th><th>Thời gian</th><th class="num">Giá trọn gói</th></tr></thead>
          <tbody><% others.forEach(function (v) { %>
            <tr><td><span class="table__country"><img src="<%= flag(v.code) %>" alt="" width="28" height="20" loading="lazy"><%= v.country %></span></td><td><%= v.type %><% if (v.note) { %><br><span class="muted"><%= v.note %></span><% } %></td><td><%= v.time %></td><td class="num"><%= priceOf(v) %></td></tr>
          <% }) %></tbody>
        </table>
      </div>
      <p class="table-note">Phí có thể thay đổi theo quy định của Đại sứ quán / Lãnh sự quán tại thời điểm nộp hồ sơ. Không thấy quốc gia bạn cần? <a href="#" data-open-lead data-service="Visa nước khác">Liên hệ TRIP</a>.</p>

      <div class="grid grid--2 mt-4">
        <div class="card">
          <h3>Giá trọn gói đã bao gồm</h3>
          <ul class="checklist"><% services.visaIncluded.forEach(function (x) { %><li><%- icon('check-circle') %><%= x %></li><% }) %></ul>
        </div>
        <div class="card">
          <h3>Chưa bao gồm</h3>
          <ul class="checklist checklist--x"><% services.visaExcluded.forEach(function (x) { %><li><%- icon('minus') %><%= x %></li><% }) %></ul>
        </div>
      </div>

      <div id="e-visa">
        <h2 class="mt-4">E-visa Việt Nam cho người nước ngoài</h2>
        <p class="muted"><%= services.evisa.note %></p>
        <div class="table-wrap">
          <table class="table">
            <thead><tr><th>Thời gian xử lý</th><th class="num">1 lần (Single)</th><th class="num">Nhiều lần (Multiple)</th></tr></thead>
            <tbody><% services.evisa.rows.forEach(function (r) { %><tr><td><%= r.speed %></td><td class="num"><%= h.usd(r.single) %></td><td class="num"><%= h.usd(r.multiple) %></td></tr><% }) %></tbody>
          </table>
        </div>
        <h3 class="mt-3">Hỗ trợ tại sân bay (Fast Track)</h3>
        <div class="table-wrap">
          <table class="table">
            <thead><tr><th>Dịch vụ</th><th class="num">Nhóm 1–5 khách</th><th class="num">Nhóm từ 6 khách</th></tr></thead>
            <tbody><% services.evisa.fastTrack.forEach(function (r) { %><tr><td><%= r.name %></td><td class="num"><%= r.small %></td><td class="num"><%= r.large %></td></tr><% }) %></tbody>
          </table>
        </div>
        <p class="table-note"><%= services.evisa.fastTrackNote %></p>
      </div>

      <div>
        <h2 class="mt-4">Câu hỏi thường gặp</h2>
        <div class="faq">
          <details class="card"><summary><strong>Tôi chưa biết nên xin loại visa nào?</strong></summary><p class="mt-2">Hãy cho TRIP biết mục đích chuyến đi, thời gian dự kiến và nghề nghiệp. Tư vấn viên sẽ đề xuất loại visa phù hợp và danh sách giấy tờ cụ thể cho trường hợp của bạn.</p></details>
          <details class="card"><summary><strong>Giấy tờ tiếng Việt có cần dịch không?</strong></summary><p class="mt-2">Phần lớn hồ sơ visa yêu cầu bản dịch công chứng. Với gói visa trọn gói, TRIP đã bao gồm dịch thuật công chứng các giấy tờ cơ bản.</p></details>
          <details class="card"><summary><strong>Tôi ở ngoài Đà Nẵng có làm được không?</strong></summary><p class="mt-2">Được. Bạn có thể gửi hồ sơ qua Zalo, email hoặc chuyển phát. TRIP sẽ hướng dẫn chi tiết từng bước.</p></details>
          <details class="card"><summary><strong>TRIP có cam kết đậu visa không?</strong></summary><p class="mt-2">Quyết định cấp visa thuộc về cơ quan lãnh sự. TRIP cam kết tư vấn đúng, chuẩn bị hồ sơ đầy đủ và trung thực để tăng tối đa khả năng được duyệt.</p></details>
        </div>
      </div>
    </div>

    <aside class="sidebar">
      <%- include('../partials/consult-box', { people: company.consultants.visa, presetService: 'Visa Trung Quốc' }) %>
    </aside>
  </div>
</section>

<%- include('../partials/footer') %>
