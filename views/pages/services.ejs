<%- include('../partials/head') %>
<%- include('../partials/page-hero', {
  crumbs: [{ label: 'Dịch vụ' }],
  heading: 'Dịch vụ của TRIP',
  sub: 'Từ giấy tờ đến chuyến đi: một đầu mối cho visa, dịch thuật, vé máy bay, tour, xe và bảo hiểm.',
  actions: {},
}) %>

<section class="section">
  <div class="container">
    <div class="pillars">
      <article class="pillar pillar--visa reveal">
        <span class="pillar__tag">Trọng tâm</span>
        <h3>Dịch vụ Visa</h3>
        <p>Visa trọn gói hơn 25 quốc gia: Trung Quốc, Nhật, Hàn, Mỹ, Châu Âu, Úc, Canada và e-visa Việt Nam cho người nước ngoài.</p>
        <div class="pillar__price"><div><small>Từ</small><strong><%= h.vnd(services.chinaVisa.rows[0].price) %></strong></div><a class="btn btn--white" href="/visa">Chi tiết <%- icon('arrow') %></a></div>
      </article>
      <article class="pillar pillar--trans reveal">
        <span class="pillar__tag">Trọng tâm</span>
        <h3>Dịch thuật công chứng</h3>
        <p>Dịch thuật Anh, Trung, Hàn, Nhật, Thái, Lào. Công chứng dấu công ty, dấu tư pháp. Hợp pháp hoá, chứng nhận lãnh sự.</p>
        <div class="pillar__price"><div><small>Từ</small><strong><%= h.vnd(services.translation.languages[0].rows[0].price) %>/trang</strong></div><a class="btn btn--white" href="/dich-vu/dich-thuat">Chi tiết <%- icon('arrow') %></a></div>
      </article>
    </div>

    <h2 class="mt-4 text-center">Dịch vụ khác</h2>
    <div class="grid grid--3 mt-3">
      <% Object.values(services.otherServices).forEach(function (s) { %>
        <a class="card card--link reveal" href="/dich-vu/<%= s.slug %>">
          <div class="card__icon"><%- icon(s.icon) %></div>
          <h3><%= s.title %></h3>
          <p><%= s.short %></p>
          <span class="more">Xem chi tiết <%- icon('arrow') %></span>
        </a>
      <% }) %>
      <a class="card card--link reveal" href="/dich-vu/hop-phap-hoa-lanh-su">
        <div class="card__icon"><%- icon('stamp') %></div>
        <h3>Hợp pháp hoá lãnh sự</h3>
        <p>Chứng nhận và hợp pháp hoá lãnh sự cho giấy tờ dân sự, học thuật, kinh tế.</p>
        <span class="more">Xem chi tiết <%- icon('arrow') %></span>
      </a>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
