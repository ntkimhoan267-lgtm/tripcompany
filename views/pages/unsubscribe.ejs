<%- include('../partials/head') %>
<section class="section">
  <div class="container text-center" style="max-width:640px">
    <% if (!sub) { %>
      <h1 style="font-size:2rem">Liên kết không hợp lệ</h1>
      <p class="lead">Liên kết huỷ đăng ký không đúng hoặc đã hết hạn. Vui lòng liên hệ <%= settings.email %>.</p>
    <% } else if (done) { %>
      <h1 style="font-size:2rem">Đã huỷ nhận bản tin</h1>
      <p class="lead">Email <strong><%= sub.email %></strong> sẽ không nhận bản tin từ TRIP nữa. Nếu muốn nhận lại, bạn nhắn TRIP qua Zalo hoặc hotline nhé.</p>
    <% } else { %>
      <h1 style="font-size:2rem">Huỷ nhận bản tin TRIP?</h1>
      <p class="lead">Email <strong><%= sub.email %></strong> sẽ không nhận lịch tour và cập nhật visa hàng tháng nữa.</p>
      <form method="post" action="/huy-dang-ky" class="mt-3">
        <input type="hidden" name="token" value="<%= token %>">
        <button class="btn btn--navy" type="submit">Xác nhận huỷ nhận tin</button>
      </form>
    <% } %>
    <a class="btn btn--ghost mt-3" href="/">Về trang chủ</a>
  </div>
</section>
<%- include('../partials/footer') %>
