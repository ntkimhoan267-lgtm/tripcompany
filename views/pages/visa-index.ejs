<%- include('../partials/head') %>
<%- include('../partials/page-hero', {
  crumbs: [{ label: 'Visa' }],
  heading: 'Visa du lịch nhanh gọn, trọn gói',
  sub: 'Thế mạnh Trung Quốc, Hàn Quốc, Nhật Bản và Châu Âu. Chọn quốc gia bạn muốn đến để xem bảng giá và thủ tục.',
  actions: { service: 'Visa Trung Quốc' },
  bg: '/media/hero-montage.jpg',
}) %>

<section class="section">
  <div class="container">
    <div class="markets markets--4">
      <% services.markets.forEach(function (m, i) { %>
        <a class="market market--<%= m.art %> reveal" href="/visa/<%= m.id %>">
          <div class="market__art">
            <video class="js-inview" src="/media/markets/<%= m.art %>.mp4" poster="/media/markets/<%= m.art %>.jpg" muted loop playsinline preload="none" aria-hidden="true"></video>
            <span class="market__native"><%= m.native %></span>
            <% if (i < 3) { %><span class="market__badge">✦ Thế mạnh</span><% } %>
          </div>
          <div class="market__body">
            <span class="market__en">Visa <%= m.en %></span>
            <h3><%= m.country %></h3>
            <div class="market__foot">
              <div><small>Trọn gói từ</small><strong><%= h.money(m.from) %></strong><span class="time"><%- icon('clock') %> <%= m.time %></span></div>
              <span class="market__go"><%- icon('arrow') %></span>
            </div>
          </div>
        </a>
      <% }) %>
    </div>

    <div class="grid grid--2 mt-4">
      <% extras.forEach(function (x) { %>
        <a class="card card--link visa-extra reveal" href="/visa/<%= x.id %>">
          <img src="<%= flag(x.code) %>" alt="" width="56" height="56">
          <div><h3><%= x.country %></h3><p><%= x.blurb %></p><span class="more">Từ <%= h.money(x.from) %> · Xem chi tiết <%- icon('arrow') %></span></div>
        </a>
      <% }) %>
    </div>
  </div>
</section>

<section class="section section--soft">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Quy trình làm visa</span>
      <h2>4 bước, từ <em>hồ sơ</em> đến <em>cửa máy bay</em></h2>
    </div>
    <ol class="steps">
      <li class="step reveal"><div class="card__icon"><%- icon('chat') %></div><h3>Tư vấn miễn phí</h3><p>TRIP tư vấn loại visa và danh sách giấy tờ phù hợp với bạn.</p></li>
      <li class="step reveal"><div class="card__icon"><%- icon('file') %></div><h3>Chuẩn bị hồ sơ</h3><p>Kiểm tra giấy tờ, dịch thuật công chứng, khai form và đặt lịch hẹn.</p></li>
      <li class="step reveal"><div class="card__icon"><%- icon('send') %></div><h3>Nộp & theo dõi</h3><p>Nộp hồ sơ tại Lãnh sự quán / trung tâm tiếp nhận, cập nhật tiến độ.</p></li>
      <li class="step reveal"><div class="card__icon"><%- icon('award') %></div><h3>Nhận kết quả</h3><p>Nhận hộ chiếu và visa, kèm tư vấn vé máy bay, bảo hiểm, eSIM.</p></li>
    </ol>
    <div class="grid grid--2 mt-4">
      <div class="card"><h3>Giá trọn gói đã bao gồm</h3><ul class="checklist"><% services.visaIncluded.forEach(function (x) { %><li><%- icon('check-circle') %><%= x %></li><% }) %></ul></div>
      <div class="card"><h3>Chưa bao gồm</h3><ul class="checklist checklist--x"><% services.visaExcluded.forEach(function (x) { %><li><%- icon('minus') %><%= x %></li><% }) %></ul></div>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
