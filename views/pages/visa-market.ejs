<%- include('../partials/head') %>
<%
  const isEvisa = page.id === 'e-visa';
  const priceOf = (v) => v.vnd ? h.vnd(v.vnd) : h.usd(v.usd);
  let rows = [];
  if (page.id === 'han-quoc') rows = services.worldVisa.filter(v => v.code === 'kr');
  if (page.id === 'nhat-ban') rows = services.worldVisa.filter(v => v.code === 'jp');
  if (page.id === 'chau-au') rows = services.worldVisa.filter(v => v.region === 'chau-au');
  if (page.id === 'nuoc-khac') rows = services.worldVisa.filter(v => !['kr', 'jp'].includes(v.code) && v.region !== 'chau-au');
  const multiCountry = ['chau-au', 'nuoc-khac'].includes(page.id);
%>
<%- include('../partials/page-hero', {
  crumbs: [{ label: 'Visa', href: '/visa' }, { label: page.short || page.country }],
  heading: isEvisa ? 'E-visa Việt Nam cho người nước ngoài' : 'Visa ' + page.country,
  sub: page.blurb,
  actions: { service: page.leadService },
  bg: page.art ? '/img/visa/' + page.art + '.jpg' : '',
}) %>

<section class="section">
  <div class="container layout-side">
    <div class="stack">
      <div class="grid grid--3 visa-facts">
        <div class="card"><div class="card__icon"><%- icon('wallet') %></div><small class="muted">Trọn gói từ</small><strong class="serif"><%= h.money(page.from) %></strong></div>
        <div class="card"><div class="card__icon"><%- icon('clock') %></div><small class="muted">Thời gian xét duyệt</small><strong><%= page.time %></strong></div>
        <div class="card"><div class="card__icon"><%- icon('award') %></div><small class="muted">Tỉ lệ đậu visa</small><strong><%= company.stats[2].value %>%</strong></div>
      </div>

      <div>
        <h2>Bảng giá <%= isEvisa ? 'E-visa' : 'visa ' + page.country %></h2>
        <% if (page.id === 'trung-quoc') { %>
          <div class="table-wrap"><table class="table">
            <thead><tr><th>Loại visa</th><th>Thời gian xét duyệt</th><th>Lưu trú / nhập cảnh</th><th class="num">Giá trọn gói</th></tr></thead>
            <tbody><% services.chinaVisa.rows.forEach(function (r) { %><tr><td><strong><%= r.type %></strong></td><td><%= r.time %></td><td class="muted"><%= r.detail %></td><td class="num"><%= h.vnd(r.price) %></td></tr><% }) %></tbody>
          </table></div>
          <p class="table-note"><%= services.chinaVisa.note %> Cần chứng nhận lãnh sự giấy tờ dùng tại Trung Quốc? Xem trang <a href="/dich-vu/hop-phap-hoa-lanh-su">Hợp pháp hoá lãnh sự</a>.</p>
        <% } else if (isEvisa) { %>
          <p class="muted"><%= services.evisa.note %></p>
          <div class="table-wrap"><table class="table">
            <thead><tr><th>Thời gian xử lý</th><th class="num">1 lần (Single)</th><th class="num">Nhiều lần (Multiple)</th></tr></thead>
            <tbody><% services.evisa.rows.forEach(function (r) { %><tr><td><%= r.speed %></td><td class="num"><%= h.usd(r.single) %></td><td class="num"><%= h.usd(r.multiple) %></td></tr><% }) %></tbody>
          </table></div>
          <h3 class="mt-3">Hỗ trợ tại sân bay (Fast Track)</h3>
          <div class="table-wrap"><table class="table">
            <thead><tr><th>Dịch vụ</th><th class="num">Nhóm 1–5 khách</th><th class="num">Nhóm từ 6 khách</th></tr></thead>
            <tbody><% services.evisa.fastTrack.forEach(function (r) { %><tr><td><%= r.name %></td><td class="num"><%= r.small %></td><td class="num"><%= r.large %></td></tr><% }) %></tbody>
          </table></div>
          <p class="table-note"><%= services.evisa.fastTrackNote %></p>
        <% } else { %>
          <div class="table-wrap"><table class="table">
            <thead><tr><% if (multiCountry) { %><th>Quốc gia</th><% } %><th>Loại visa</th><th>Thời gian xét duyệt</th><th class="num">Giá trọn gói</th></tr></thead>
            <tbody><% rows.forEach(function (v) { %>
              <tr>
                <% if (multiCountry) { %><td><span class="table__country"><img src="<%= flag(v.code) %>" alt="" width="28" height="20" loading="lazy"><%= v.country %></span></td><% } %>
                <td><strong><%= v.type %></strong><% if (v.note) { %><br><span class="muted"><%= v.note %></span><% } %></td>
                <td><%= v.time %></td>
                <td class="num"><%= priceOf(v) %></td>
              </tr>
            <% }) %></tbody>
          </table></div>
          <p class="table-note">Phí có thể thay đổi theo quy định của Đại sứ quán / Lãnh sự quán tại thời điểm nộp hồ sơ.<% if (page.id === 'chau-au') { %> Đã gồm luyện phỏng vấn 1 kèm 1. Bảo hiểm du lịch bắt buộc với khối Schengen, TRIP có sẵn gói của Liberty.<% } %></p>
        <% } %>
      </div>

      <% if (!isEvisa) { %>
      <div class="grid grid--2">
        <div class="card"><h3>Giá trọn gói đã bao gồm</h3><ul class="checklist"><% services.visaListFor(services.visaIncluded, page.id).forEach(function (x) { %><li><%- icon('check-circle') %><%= x %></li><% }) %></ul></div>
        <div class="card"><h3>Chưa bao gồm</h3><ul class="checklist checklist--x"><% services.visaListFor(services.visaExcluded, page.id).forEach(function (x) { %><li><%- icon('minus') %><%= x %></li><% }) %></ul></div>
      </div>
      <% } %>

      <div>
        <h2>Visa nước khác</h2>
        <div class="other-visas">
          <% others.forEach(function (o) { %>
            <a href="/visa/<%= o.id %>"><img src="<%= flag(o.code) %>" alt="" width="32" height="32"><span><strong><%= o.short || 'Visa ' + o.country %></strong>Từ <%= h.money(o.from) %></span><%- icon('arrow') %></a>
          <% }) %>
        </div>
      </div>
    </div>

    <aside class="sidebar">
      <%- include('../partials/consult-box', { people: company.consultants.visa, presetService: page.leadService }) %>
    </aside>
  </div>
</section>

<%- include('../partials/footer') %>
