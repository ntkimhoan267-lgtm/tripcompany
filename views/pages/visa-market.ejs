<%- include('../partials/head') %>
<%
  const isEvisa = page.id === 'e-visa';
  let rows = [];
  if (page.id === 'han-quoc') rows = services.worldVisa.filter(v => v.code === 'kr');
  if (page.id === 'nhat-ban') rows = services.worldVisa.filter(v => v.code === 'jp');
  if (page.id === 'chau-au') rows = services.worldVisa.filter(v => v.region === 'chau-au');
  if (page.id === 'nuoc-khac') rows = services.worldVisa.filter(v => !['kr', 'jp'].includes(v.code) && v.region !== 'chau-au');
  const multiCountry = ['chau-au', 'nuoc-khac'].includes(page.id);
  let items = [];
  if (page.id === 'trung-quoc') items = services.chinaVisa.rows.map((r, i) => ({ title: r.type, tag: r.detail, time: r.time, priceHtml: price(r.price, 'vnd', 'cn', { service: page.leadService }), popular: i === 0 }));
  else if (!multiCountry && !isEvisa) items = rows.map((v, i) => ({ title: v.type, time: v.time, priceHtml: v.vnd != null ? price(v.vnd, 'vnd', 'world', { service: page.leadService }) : price(v.usd, 'usd', 'world', { service: page.leadService }), note: v.note, popular: i === 0 }));
  const STAMPS = {
    cn: { top: 'VISA · CHINA · TRUNG QUỐC · ', mid: '中国', cls: 'stamp--cn' },
    kr: { top: 'VISA · KOREA · HÀN QUỐC · ', mid: '한국', cls: 'stamp--kr' },
    jp: { top: 'VISA · JAPAN · NHẬT BẢN · ', mid: '日本', cls: 'stamp--jp' },
    eu: { top: 'SCHENGEN · EUROPE · ', mid: 'EU', cls: 'stamp--eu' },
  };
  const st = STAMPS[page.art] || { top: isEvisa ? 'E-VISA · VIETNAM · WELCOME · ' : 'VISA · WORLD · TRIP · ', mid: isEvisa ? 'VN' : '✦', cls: 'stamp--kr' };
  const visual = media('visa_' + (page.art || page.id));
%>
<%- include('../partials/page-hero', {
  crumbs: [{ label: 'Visa', href: '/visa' }, { label: page.short || page.country }],
  heading: isEvisa ? 'E-visa Việt Nam' : 'Visa',
  headingEm: isEvisa ? 'cho người nước ngoài' : page.country,
  sub: page.blurb,
  actions: { service: page.leadService },
  visual: visual,
  video: page.art || 'montage',
  stamp: Object.assign({ sub: 'APPROVED' }, st, { cls: 'stamp--hero ' + st.cls }),
  badge: { value: company.stats[2].value + '%', label: 'Tỉ lệ đậu visa' },
  facts: [
    { icon: 'wallet', label: 'Trọn gói từ', html: page.art ? price.from(page.from, 'markets', { service: page.leadService }) : h.money(page.from) },
    { icon: 'clock', label: 'Xét duyệt', value: page.time },
  ],
}) %>

<section class="section">
  <div class="container layout-side">
    <div class="stack stack--lg">
      <div>
        <div class="block-head">
          <span class="eyebrow">Bảng giá</span>
          <h2>Chọn loại <em><%= isEvisa ? 'E-visa' : 'visa' %></em> phù hợp</h2>
        </div>
        <%- include('../partials/offer-bar', { service: page.leadService, groups: [isEvisa ? 'evisa' : page.id === 'trung-quoc' ? 'cn' : 'world'] }) %>
        <% if (isEvisa) { %>
          <%- include('../partials/price/evisa') %>
          <h3 class="ppanel__sub">Hỗ trợ tại sân bay (Fast Track)</h3>
          <div class="pcards pcards--2">
            <% services.evisa.fastTrack.forEach(function (r) { %>
              <article class="pcard"><div class="pcard__top"><div><h3 class="pcard__title"><%= r.name %></h3></div></div>
                <div class="pcard__split"><div><small>Nhóm 1–5 khách</small><strong><%= r.small %></strong></div><div><small>Nhóm từ 6 khách</small><strong><%= r.large %></strong></div></div>
              </article>
            <% }) %>
          </div>
          <p class="ppanel__note"><%- icon('info') %><%= services.evisa.fastTrackNote %></p>
        <% } else if (multiCountry) { %>
          <%- include('../partials/price/countries', { rows: rows }) %>
          <p class="ppanel__note"><%- icon('info') %>Phí có thể thay đổi theo quy định của Đại sứ quán / Lãnh sự quán.<% if (page.id === 'chau-au') { %> Đã gồm luyện phỏng vấn 1 kèm 1. Bảo hiểm du lịch bắt buộc với khối Schengen, TRIP có sẵn gói của Liberty.<% } %></p>
        <% } else { %>
          <%- include('../partials/price/options', { items: items, service: page.leadService }) %>
          <p class="ppanel__note"><%- icon('info') %><% if (page.id === 'trung-quoc') { %><%= services.chinaVisa.note %> Cần chứng nhận lãnh sự giấy tờ dùng tại Trung Quốc? Xem <a href="/dich-vu/hop-phap-hoa-lanh-su">Hợp pháp hoá lãnh sự</a>.<% } else { %>Phí có thể thay đổi theo quy định của Đại sứ quán / Lãnh sự quán tại thời điểm nộp hồ sơ.<% } %></p>
        <% } %>
      </div>

      <% if (!isEvisa) { %>
      <div class="incl">
        <div class="incl__col incl__col--yes"><h3><%- icon('check-circle') %> Giá trọn gói đã bao gồm</h3><ul><% services.visaListFor(services.visaIncluded, page.id).forEach(function (x) { %><li><%= x %></li><% }) %></ul></div>
        <div class="incl__col"><h3><%- icon('minus') %> Chưa bao gồm</h3><ul><% services.visaListFor(services.visaExcluded, page.id).forEach(function (x) { %><li><%= x %></li><% }) %></ul></div>
      </div>
      <% } %>

      <div>
        <div class="block-head">
          <span class="eyebrow">Hồ sơ cần chuẩn bị</span>
          <h2>Giấy tờ <em>cơ bản</em></h2>
        </div>
        <%- include('../partials/visa-docs', { list: services.visaDocs[page.id] || services.visaDocs.default }) %>
      </div>

      <div class="check-band">
        <img class="check-band__logo" src="/img/logo-icon-sm.png" alt="" width="160" height="160">
        <div>
          <h3>Kiểm tra hồ sơ miễn phí trước khi nộp</h3>
          <p><% if (isEvisa) { %>Gửi ảnh trang thông tin hộ chiếu và ảnh chân dung, TRIP kiểm tra trước khi nộp để tránh sai thông tin.<% } else { %>Mỗi hồ sơ có yêu cầu riêng tuỳ nghề nghiệp và mục đích chuyến đi. Gửi ảnh giấy tờ, TRIP gửi lại danh sách cần bổ sung.<% } %></p>
          <div class="flex">
            <% if (settings.zalo) { %><a class="btn btn--zalo" href="https://zalo.me/<%= h.phoneTel(settings.zalo) %>" target="_blank" rel="noopener">Gửi giấy tờ qua Zalo</a><% } %>
            <button class="btn btn--outline-white" data-open-lead data-service="<%= page.leadService %>">Để TRIP gọi lại</button>
          </div>
        </div>
      </div>

      <div>
        <div class="block-head"><span class="eyebrow">Khám phá thêm</span><h2>Visa <em>nước khác</em></h2></div>
        <div class="other-visas">
          <% others.forEach(function (o) { %>
            <a href="/visa/<%= o.id %>"><img src="<%= flag(o.code) %>" alt="" width="32" height="32"><span><strong><%= o.short || 'Visa ' + o.country %></strong>Từ <%- o.art ? price.from(o.from, 'markets', { inLink: true }) : h.money(o.from) %></span><%- icon('arrow') %></a>
          <% }) %>
        </div>
      </div>
    </div>

    <aside class="sidebar">
      <%- include('../partials/consult-box', { people: company.consultants.visa, presetService: page.leadService }) %>
    </aside>
  </div>
</section>

<%- include('../partials/footer') %>
