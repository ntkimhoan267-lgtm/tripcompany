<section class="page-hero<%= typeof bg !== 'undefined' && bg ? ' page-hero--photo' : '' %>"<% if (typeof bg !== 'undefined' && bg) { %> style="--bg:url('<%= bg %>')"<% } %>>
  <div class="sparkles"><i style="top:18%;left:70%;--s:12px"></i><i style="top:40%;left:88%;--s:9px;--d:-1s"></i><i style="top:12%;left:52%;--s:7px;--d:-2s"></i></div>
  <div class="container" style="position:relative;z-index:1">
    <ol class="breadcrumb" aria-label="Breadcrumb">
      <li><a href="/">Trang chủ</a></li>
      <% (crumbs || []).forEach(function (c) { %><li><% if (c.href) { %><a href="<%= c.href %>"><%= c.label %></a><% } else { %><%= c.label %><% } %></li><% }) %>
    </ol>
    <h1><%= heading %></h1>
    <% if (typeof sub !== 'undefined' && sub) { %><p><%= sub %></p><% } %>
    <% if (typeof actions !== 'undefined' && actions) { %>
      <div class="hero__actions">
        <button class="btn btn--accent" data-open-lead<% if (actions.service) { %> data-service="<%= actions.service %>"<% } %>><%- icon('chat') %> Tư vấn miễn phí</button>
        <a class="btn btn--outline-white" href="tel:<%= h.phoneTel(actions.phone || settings.hotline) %>"><%- icon('phone') %> <%= h.phoneDisplay(actions.phone || settings.hotline) %></a>
      </div>
    <% } %>
  </div>
  <%- include('clouds', { end: '#ffffff' }) %>
</section>
