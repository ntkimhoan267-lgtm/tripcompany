<div class="routes">
  <% services.carTransfer.rows.forEach(function (r) { %>
    <article class="route">
      <div class="route__img"><%- h.picture(r.image || media('svc_thue-xe'), { alt: r.route, width: 800, height: 600, sizes: '(max-width: 640px) 100vw, 400px' }) %><% if (r.way) { %><span><%= r.way %></span><% } %></div>
      <div class="route__body">
        <h3><%= r.route.replace(/^KS Đà Nẵng – /, '') %></h3>
        <p><%= /^KS Đà Nẵng/.test(r.route) ? 'Từ khách sạn Đà Nẵng' : 'Đưa đón trong thành phố' %></p>
        <ul class="route__prices">
          <li><small>4 chỗ</small><b><%- price(r.p4, 'vnd', 'cars', { service: 'Thuê xe / Xe đưa đón' }) %></b></li>
          <li><small>7 chỗ</small><b><%- price(r.p7, 'vnd', 'cars', { service: 'Thuê xe / Xe đưa đón' }) %></b></li>
          <li><small>16 chỗ</small><b><%- price(r.p16, 'vnd', 'cars', { service: 'Thuê xe / Xe đưa đón' }) %></b></li>
        </ul>
      </div>
    </article>
  <% }) %>
</div>
