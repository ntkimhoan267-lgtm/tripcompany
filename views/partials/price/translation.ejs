<% const tr = services.translation; const deco = { anh: 'EN', 'trung-han-nhat': '中 한 日', 'thai-lao': 'ไทย ລາວ' }; %>
<div class="plans">
  <% tr.languages.filter(function (l) { return l.rows[0].price; }).forEach(function (l, i) { %>
    <article class="plan<%= i === 1 ? ' plan--hot' : '' %>">
      <header class="plan__head">
        <span class="plan__deco" aria-hidden="true"><%= deco[l.id] || '' %></span>
        <% if (i === 1) { %><span class="plan__ribbon">Thế mạnh</span><% } %>
        <h3><%= l.label %></h3>
        <p><%= l.pair %></p>
        <div class="plan__from"><small>Chỉ từ</small><strong><%= h.vnd(l.rows[0].price) %></strong><small>/<%= tr.unit %></small></div>
      </header>
      <ul class="plan__list">
        <% l.rows.forEach(function (r) { %><li><span><%- icon('check-circle') %><%= r.level %></span><b><%= h.vnd(r.price) %></b></li><% }) %>
      </ul>
      <button class="btn <%= i === 1 ? 'btn--accent' : 'btn--navy' %> btn--block" data-open-lead data-service="Dịch thuật công chứng">Báo giá <%= l.label %></button>
    </article>
  <% }) %>
</div>
<p class="plans__other"><%- icon('globe') %> <span><strong>Ngôn ngữ khác</strong> (Pháp, Đức, Nga, Tây Ban Nha…): báo giá khi nhận tài liệu.</span></p>
